#!/usr/bin/env bash
set -euo pipefail
# The window launcher: a game window, recorded from startup. Installed by install-launcher.sh.
# BORG_REBORN_RS: the main checkout, which holds the character's data dir (.angband-reborn).
repo=${BORG_REBORN_RS:-$HOME/projects/angband/borg-reborn-rs}
install_dir=$(cd "$(dirname "$(realpath "$0")")" && pwd)
recorder="$install_dir/angband-recorder"
recording_streams() {
    if [ -d "$1/native" ]; then printf '%s\n' "$1/native"; else printf '%s\n' "$1"; fi
}
record=1 borg=0 delay=
while [ "$#" -gt 0 ]; do
    case "$1" in
        --no-record) record=0; shift ;;
        --borg) borg=1; shift ;;
        --delay) delay=${2:?--delay needs a number, 0 to 255}; shift 2 ;;
        --auto) borg=1; delay=0; shift ;;
        *) break ;;
    esac
done
case "$delay" in ''|*[!0-9]*) [ -z "$delay" ] || { printf -- '--delay needs a number, 0 to 255\n' >&2; exit 2; } ;; esac
[ -z "$delay" ] || [ "$delay" -le 255 ] || { printf -- '--delay needs a number, 0 to 255\n' >&2; exit 2; }
case "${1:-}" in
    -h|--help)
        printf '%s\n' 'Usage: angband-reborn-record [--no-record] [--delay MSEC] [--borg | --auto] [CHARACTER]' \
            '       angband-reborn-record --watch RECORDING [--from-turn TURN]' \
            '       angband-reborn-record --frame RECORDING [FRAME]' \
            '--no-record: play without a recording (same saves and settings). Default character: RustBorg.' \
            '--delay MSEC: set the base delay factor (0-255; it is saved with the character).' \
            '--borg: start the Borg once the game is up.  --auto: --delay 0 and --borg.' \
            '  (these send the game its own keys; they need xdotool, ImageMagick and an existing character).' \
            'Recordings go to ~/angband-recordings.'
        exit 0 ;;
    --watch|--frame)
        mode=$1
        streams=$(recording_streams "${2:?give the recording directory}")
        shift 2
        if [ "$mode" = --watch ]; then
            exec python3 "$install_dir/watch-recording.py" "$streams" "$@"
        fi
        if [ "$#" -eq 0 ]; then
            last=$(python3 -c 'import json, sys; print(json.load(open(sys.argv[1]))["frames"])' "$streams/complete.json")
            set -- "$last"
        fi
        exec "$recorder" view "$streams" "$@" ;;
    -*) printf 'Unknown option: %s\n' "$1" >&2; exit 2 ;;
esac
if [ "$#" -gt 1 ]; then
    printf 'Usage: angband-reborn-record [--no-record] [--delay MSEC] [--borg | --auto] [CHARACTER]\n' >&2
    exit 2
fi
name=${1:-RustBorg}
if [ -z "${DISPLAY:-}" ]; then
    printf 'Angband needs an X11 display. Start this launcher from your desktop session.\n' >&2
    exit 1
fi
data=${BORG_PLAY_DATA_DIR:-$repo/.angband-reborn}
recordings=${BORG_RECORDINGS_DIR:-$HOME/angband-recordings}
mkdir -p "$data"/{user,save,archive,panic,scores} "$recordings"
data=$(realpath "$data")
recordings=$(realpath "$recordings")
if [ ! -e "$data/user/borg.txt" ]; then
    cp "$repo/.angband-reborn/user/borg.txt" "$data/user/borg.txt"
    for setting_file in errands_plan.txt scary_monsters.txt; do
        if [ ! -e "$data/user/$setting_file" ]; then
            cp "$repo/.angband-reborn/user/$setting_file" "$data/user/$setting_file"
        fi
    done
fi
# The settings file is copied once and then kept, so a newer build can run with a stale one (missing
# parameters, or old values such as a recovery switched off). Say so, with the command that refreshes it.
shipped="$install_dir/../harness/borg.txt"
if [ -f "$shipped" ] && [ -f "$data/user/borg.txt" ]; then
    keys() { grep -oE '^[a-z_0-9]+ *=' "$1" | tr -d ' =' | sort -u; }
    missing=$(comm -13 <(keys "$data/user/borg.txt") <(keys "$shipped") | wc -l)
    if [ "$missing" -gt 0 ]; then
        printf 'angband-reborn-record: warning: %s lacks %s settings this build ships; the game uses its older values.\n' \
            "$data/user/borg.txt" "$missing" >&2
        printf '  To use the build'"'"'s: cp -p %s %s.before-$(date +%%Y%%m%%d) && cp %s %s\n' \
            "$data/user/borg.txt" "$data/user/borg.txt" "$(realpath "$shipped")" "$data/user/borg.txt" >&2
    fi
fi
# --delay / --borg: once the window is up, press the game's own keys in it: "=" "d" N Return Escape sets the
# base delay factor, Ctrl-Z "z" starts the Borg. A new character needs its birth screens first, so refuse that.
if [ -n "$delay" ] || [ "$borg" = 1 ]; then
    command -v xdotool >/dev/null || { printf 'angband-reborn-record: --delay/--borg need xdotool\n' >&2; exit 1; }
    [ -f "$data/save/$name" ] || {
        printf 'angband-reborn-record: %s has no save yet: make the character first (start without --delay/--borg),\n  quit with Ctrl-X, then start it again with these options.\n' "$name" >&2
        exit 1; }
    known=$(xdotool search --name '^Angband' 2>/dev/null | sort || true)
    (
        win=
        for _ in $(seq 1 100); do
            for id in $(xdotool search --name '^Angband' 2>/dev/null || true); do
                grep -qx "$id" <<<"$known" || win=$id
            done
            [ -z "$win" ] || break
            sleep 0.3
        done
        [ -n "$win" ] || exit 0
        sleep "${AUTOSTART_WAIT:-4}"
        press() { xdotool windowactivate --sync "$win" 2>/dev/null || true
                  xdotool key --window "$win" --delay 60 "$@"; sleep 0.4; }
        press Escape
        if [ -n "$delay" ]; then
            press equal d
            press $(printf '%s' "$delay" | sed 's/./& /g') Return
            press Escape Escape
        fi
        if [ "$borg" = 1 ]; then
            press ctrl+z
            # A character that has never run the Borg gets two long messages (-more-) and a y/n question first. A pending
            # message on the top row reaching right of column 40 tells it apart from the short Borg prompt.
            if command -v import >/dev/null && command -v convert >/dev/null \
                && [ "$(import -window "$win" -crop 500x22+400+0 +repage png:- 2>/dev/null \
                        | convert png:- -format '%[fx:maxima>0.1?1:0]' info: 2>/dev/null)" = 1 ]; then
                press Return Return y
            fi
            press z
        fi
    ) >/dev/null 2>&1 &
fi
if [ "$record" = 0 ]; then
    # No ANGBAND_RECORD_DIR, so the game does not record (the recorder is inert without it).
    cd "$install_dir/game"
    exec ./angband -mx11 \
        -duser="$data/user" -dsave="$data/save" -darchive="$data/archive" \
        -dpanic="$data/panic" -dscores="$data/scores" -u"$name"
fi
label=${name//[^a-zA-Z0-9_-]/_}
session=$(mktemp -d "$recordings/$(date +%Y%m%d-%H%M%S)-${label:0:40}.XXXXXX")
mkdir "$session/borg-settings"
for setting_file in borg.txt errands_plan.txt scary_monsters.txt; do
    if [ -f "$data/user/$setting_file" ]; then
        cp "$data/user/$setting_file" "$session/borg-settings/$setting_file"
    fi
done
printf 'Recording to %s\n' "$session"
cd "$install_dir/game"
exec "$recorder" record "$session/native" -- ./angband -mx11 \
    -duser="$data/user" -dsave="$data/save" -darchive="$data/archive" \
    -dpanic="$data/panic" -dscores="$data/scores" -u"$name"
